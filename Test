local OrionLib = loadstring(game:HttpGet(
    "https://raw.githubusercontent.com/Qanuir/orion-ui/refs/heads/main/source.lua"
))()

local Players           = game:GetService("Players")
local RunService        = game:GetService("RunService")
local ReplicatedStorage = game:GetService("ReplicatedStorage")
local StarterGui        = game:GetService("StarterGui")

local LocalPlayer = Players.LocalPlayer

-- ============================================================
-- Notify
-- ============================================================
local function Notify(title, text, duration)
    StarterGui:SetCore("SendNotification", {
        Title    = title,
        Text     = text,
        Duration = duration
    })
end

-- ============================================================
-- Noclip
-- ============================================================
local noclipConnection = nil

local function SetNoclip(state)
    if noclipConnection then noclipConnection:Disconnect() noclipConnection = nil end
    if state then
        noclipConnection = RunService.Stepped:Connect(function()
            local char = LocalPlayer.Character
            if not char then return end
            for _, part in ipairs(char:GetDescendants()) do
                if part:IsA("BasePart") and part.CanCollide then
                    part.CanCollide = false
                end
            end
        end)
        Notify("Noclip", "有効", 2)
    else
        Notify("Noclip", "無効", 2)
    end
end

-- ============================================================
-- 三人称化（Classic カメラを強制）
-- ============================================================
local thirdPersonConnection = nil

local function EnforceThirdPerson()
    if LocalPlayer.CameraMode ~= Enum.CameraMode.Classic then
        LocalPlayer.CameraMode = Enum.CameraMode.Classic
    end
    if LocalPlayer.CameraMaxZoomDistance < 12 then
        LocalPlayer.CameraMaxZoomDistance = 12
    end
    local char = LocalPlayer.Character
    if char then
        local hum = char:FindFirstChildOfClass("Humanoid")
        if hum and hum.CameraOffset ~= Vector3.new(0, 0, 0) then
            hum.CameraOffset = Vector3.new(0, 0, 0)
        end
    end
end

local function SetThirdPerson(state)
    if thirdPersonConnection then thirdPersonConnection:Disconnect() thirdPersonConnection = nil end
    if state then
        thirdPersonConnection = RunService.RenderStepped:Connect(EnforceThirdPerson)
        Notify("View", "三人称化 有効", 2)
    else
        Notify("View", "三人称化 無効", 2)
    end
end

LocalPlayer.CharacterAdded:Connect(function()
    task.wait(0.5)
    if thirdPersonConnection then
        EnforceThirdPerson()
    end
end)

-- ============================================================
-- Toy 個別固定管理
-- ============================================================
local activeToys = {}   -- [Player] = { toy = Instance, conn = RBXScriptConnection }

local function StopFixFor(plr)
    local data = activeToys[plr]
    if not data then return end
    if data.conn then data.conn:Disconnect() end
    if data.toy then
        pcall(function()
            ReplicatedStorage.MenuToys.DestroyToy:FireServer(data.toy)
        end)
    end
    activeToys[plr] = nil
end

local function StartFixFor(plr)
    if activeToys[plr] then return end
    if not plr.Character then return end
    local root = plr.Character:FindFirstChild("HumanoidRootPart")
    if not root then return end

    local existing = {}
    local folder0 = workspace:FindFirstChild("i1aljSpawnedInToys")
    if folder0 then
        for _, v in ipairs(folder0:GetChildren()) do existing[v] = true end
    end

    pcall(function()
        ReplicatedStorage.MenuToys.SpawnToyRemoteFunction:InvokeServer(table.unpack({
            [1] = "SprayCanWD",
            [2] = root.CFrame,
            [3] = Vector3.new(0, 0, 0),
        }))
    end)

    task.wait(0.15)

    local folder = workspace:FindFirstChild("i1aljSpawnedInToys")
    if not folder then return end

    local newToy
    for _, v in ipairs(folder:GetChildren()) do
        if not existing[v] then newToy = v break end
    end
    if not newToy then return end

    local conn = RunService.Heartbeat:Connect(function()
        if not newToy or not newToy.Parent then
            if activeToys[plr] and activeToys[plr].conn then
                activeToys[plr].conn:Disconnect()
            end
            activeToys[plr] = nil
            return
        end
        local char = plr.Character
        if not char then return end
        local r = char:FindFirstChild("HumanoidRootPart")
        if not r then return end
        pcall(function()
            if newToy:IsA("BasePart") then
                newToy.CFrame = r.CFrame
            elseif newToy:IsA("Model") then
                if not newToy.PrimaryPart then
                    for _, p in ipairs(newToy:GetDescendants()) do
                        if p:IsA("BasePart") then newToy.PrimaryPart = p break end
                    end
                end
                if newToy.PrimaryPart then newToy:PivotTo(r.CFrame) end
            end
        end)
    end)

    activeToys[plr] = { toy = newToy, conn = conn }
end

local function StopAllFixes()
    for plr, _ in pairs(activeToys) do
        StopFixFor(plr)
    end
    Notify("Toy", "すべての固定を停止しました", 2)
end

-- ============================================================
-- UI 非等方スケーリング（横幅・高さを個別倍率）
-- ============================================================
local uiOriginalSizes = setmetatable({}, { __mode = "k" })
local uiMulX, uiMulY   = 1, 1
local uiLoopRunning    = false

local function GetOrionScreenGui()
    local parents = {}
    if gethui then pcall(function() table.insert(parents, gethui()) end) end
    pcall(function() table.insert(parents, game:GetService("CoreGui")) end)
    pcall(function() table.insert(parents, LocalPlayer:FindFirstChild("PlayerGui")) end)

    for _, p in ipairs(parents) do
        if p then
            for _, v in ipairs(p:GetChildren()) do
                if v:IsA("ScreenGui") and v.Name == "Orion" then
                    return v
                end
            end
        end
    end
    return nil
end

local function ApplyUIScale()
    local gui = GetOrionScreenGui()
    if not gui then return end

    for _, obj in ipairs(gui:GetDescendants()) do
        if obj:IsA("GuiObject") then
            if not uiOriginalSizes[obj] then
                uiOriginalSizes[obj] = obj.Size
            end
            local orig = uiOriginalSizes[obj]
            local newSize = UDim2.new(
                orig.X.Scale  * uiMulX, orig.X.Offset * uiMulX,
                orig.Y.Scale  * uiMulY, orig.Y.Offset * uiMulY
            )
            if obj.Size ~= newSize then
                obj.Size = newSize
            end
        end
    end
end

local function StartUILoop()
    if uiLoopRunning then return end
    uiLoopRunning = true
    task.spawn(function()
        while uiLoopRunning do
            if uiMulX ~= 1 or uiMulY ~= 1 then
                ApplyUIScale()
            end
            task.wait(0.3)
        end
    end)
end

-- ============================================================
-- Orion GUI 構築
-- ============================================================
local Window = OrionLib:MakeWindow({
    Name         = "Toy Controller",
    HidePremium  = false,
    SaveConfig   = false,
    IntroEnabled = true,
    IntroText    = "Toy Controller",
    ConfigFolder = "ToyController"
})

-- ---------- メイン ----------
local MainTab = Window:MakeTab({
    Name        = "メイン",
    Icon        = "rbxassetid://4483345998",
    PremiumOnly = false
})

local function GetSelectablePlayerNames()
    local names = {}
    for _, plr in ipairs(Players:GetPlayers()) do
        if plr ~= LocalPlayer then
            table.insert(names, plr.Name)
        end
    end
    table.sort(names)
    return names
end

local function FindPlayerByName(name)
    for _, plr in ipairs(Players:GetPlayers()) do
        if plr.Name == name then return plr end
    end
    return nil
end

local PlayerDropdown
PlayerDropdown = MainTab:AddDropdown({
    Name    = "Toy固定するプレイヤー（複数選択）",
    Options = GetSelectablePlayerNames(),
    Default = {},
    Multi   = true,
    Callback = function(selected)
        for plr, _ in pairs(activeToys) do
            if not (selected and selected[plr.Name]) then
                StopFixFor(plr)
            end
        end
        if selected then
            for name, isOn in pairs(selected) do
                if isOn then
                    local plr = FindPlayerByName(name)
                    if plr and not activeToys[plr] then
                        task.spawn(function() StartFixFor(plr) end)
                    end
                end
            end
        end
    end
})

MainTab:AddButton({
    Name = "プレイヤーリストを更新",
    Callback = function()
        local names = GetSelectablePlayerNames()
        if PlayerDropdown and PlayerDropdown.Refresh then
            PlayerDropdown:Refresh(names, true)
        end
        Notify("Toy", "プレイヤーリストを更新しました", 2)
    end
})

MainTab:AddButton({
    Name = "すべてのToy固定を停止",
    Callback = function()
        StopAllFixes()
        if PlayerDropdown and PlayerDropdown.Refresh then
            PlayerDropdown:Refresh(GetSelectablePlayerNames(), true)
        end
    end
})

MainTab:AddToggle({
    Name     = "三人称化",
    Default  = false,
    Callback = function(value)
        SetThirdPerson(value)
    end
})

MainTab:AddToggle({
    Name     = "Noclip",
    Default  = false,
    Callback = function(value)
        SetNoclip(value)
    end
})

