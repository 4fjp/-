if not okMain then
    Notify("エラー", "GUI生成エラー: " .. tostring(errMain), 5)
    return
end

--// ============================================
--// タッチ対応ドラッグ処理（OrionLibウィンドウに追加）
--// ============================================

task.spawn(function()
    task.wait(1)

    local orionGui = nil
    if gethui then
        orionGui = gethui():FindFirstChild("Orion")
    end
    if not orionGui then
        orionGui = game:GetService("CoreGui"):FindFirstChild("Orion")
    end
    if not orionGui then
        orionGui = LocalPlayer.PlayerGui:FindFirstChild("Orion")
    end

    if not orionGui then
        Notify("情報", "Orionウィンドウを検出できませんでした", 3)
        return
    end

    local mainFrame = orionGui:FindFirstChild("MainFrame") or orionGui:FindFirstChildWhichIsA("Frame", true)
    if not mainFrame then
        Notify("情報", "メインフレームを検出できませんでした", 3)
        return
    end

    local dragHandle = mainFrame:FindFirstChild("TopBar") or mainFrame:FindFirstChild("TitleBar") or mainFrame

    local dragging = false
    local dragInput = nil
    local startPos = nil
    local startInputPos = nil

    dragHandle.InputBegan:Connect(function(input)
        if input.UserInputType == Enum.UserInputType.MouseButton1 or input.UserInputType == Enum.UserInputType.Touch then
            dragging = true
            startInputPos = input.Position
            startPos = mainFrame.Position
            input.Changed:Connect(function()
                if input.UserInputState == Enum.UserInputState.End then
                    dragging = false
                end
            end)
        end
    end)

    dragHandle.InputChanged:Connect(function(input)
        if input.UserInputType == Enum.UserInputType.MouseMovement or input.UserInputType == Enum.UserInputType.Touch then
            dragInput = input
        end
    end)

    UserInputService.InputChanged:Connect(function(input)
        if input == dragInput and dragging then
            local delta = input.Position - startInputPos
            mainFrame.Position = UDim2.new(
                startPos.X.Scale, startPos.X.Offset + delta.X,
                startPos.Y.Scale, startPos.Y.Offset + delta.Y
            )
        end
    end)

    Notify("情報", "タッチドラッグを有効化しました", 2)
end)

Notify("読み込み完了", "Toy Attacherを起動しました", 3)


