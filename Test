local OrionLib = loadstring(game:HttpGet(
    "https://raw.githubusercontent.com/Qanuir/orion-ui/refs/heads/main/source.lua"
))()

local Players           = game:GetService("Players")
local RunService        = game:GetService("RunService")
local ReplicatedStorage = game:GetService("ReplicatedStorage")
local StarterGui        = game:GetService("StarterGui")

local LocalPlayer = Players.LocalPlayer

-- ============================================================
-- Notify (print は使用しない)
-- ============================================================
local function Notify(title, text, duration)
    StarterGui:SetCore("SendNotification", {
        Title    = title,
        Text     = text,
        Duration = duration
    })
end

-- ============================================================
-- ターゲット自動取得（最寄りの他プレイヤー）
-- ============================================================
local function GetNearestTarget()
    local myRoot = LocalPlayer.Character and LocalPlayer.Character:FindFirstChild("HumanoidRootPart")
    if not myRoot then return nil end

    local closest, dist = nil, math.huge
    for _, plr in ipairs(Players:GetPlayers()) do
        if plr ~= LocalPlayer and plr.Character then
            local root = plr.Character:FindFirstChild("HumanoidRootPart")
            if root then
                local d = (root.Position - myRoot.Position).Magnitude
                if d < dist then
                    closest = plr
                    dist = d
                end
            end
        end
    end
    return closest
end

-- ============================================================
-- 状態管理
-- ============================================================
local currentToy        = nil
local fixConnection     = nil
local currentTarget     = nil
local viewIsFirstPerson = false

-- ============================================================
-- Toy生成 & 体の中心に固定
-- ============================================================
local function SpawnAndFix()
    local target = GetNearestTarget()
    if not target or not target.Character then
        Notify("Toy", "ターゲットが見つかりません", 3)
        return
    end
    local root = target.Character:FindFirstChild("HumanoidRootPart")
    if not root then
        Notify("Toy", "HumanoidRootPartが見つかりません", 3)
        return
    end

    -- 前回の接続とToyをクリーンアップ
    if fixConnection then fixConnection:Disconnect() fixConnection = nil end
    if currentToy then
        pcall(function()
            ReplicatedStorage.MenuToys.DestroyToy:FireServer(currentToy)
        end)
        currentToy = nil
    end

    currentTarget = target

    -- ターゲットのRoot位置でToyを生成
    local cframe = root.CFrame
    pcall(function()
        ReplicatedStorage.MenuToys.SpawnToyRemoteFunction:InvokeServer(table.unpack({
            [1] = "SprayCanWD",
            [2] = cframe,
            [3] = Vector3.new(0, 0, 0),
        }))
    end)

    task.wait(0.15)

    local toysFolder = workspace:FindFirstChild("i1aljSpawnedInToys")
    if toysFolder then
        currentToy = toysFolder:FindFirstChild("SprayCanWD")
    end

    if not currentToy then
        Notify("Toy", "Toyの生成に失敗しました", 3)
        return
    end

    -- 毎フレーム、Toyをターゲットの体の中心に固定
    fixConnection = RunService.Heartbeat:Connect(function()
        if not currentToy or not currentToy.Parent then
            if fixConnection then fixConnection:Disconnect() fixConnection = nil end
            return
        end
        local char = currentTarget and currentTarget.Character
        if not char then return end
        local r = char:FindFirstChild("HumanoidRootPart")
        if not r then return end

        pcall(function()
            if currentToy:IsA("BasePart") then
                currentToy.CFrame = r.CFrame
            elseif currentToy:IsA("Model") then
                if not currentToy.PrimaryPart then
                    for _, p in ipairs(currentToy:GetDescendants()) do
                        if p:IsA("BasePart") then
                            currentToy.PrimaryPart = p
                            break
                        end
                    end
                end
                if currentToy.PrimaryPart then
                    currentToy:PivotTo(r.CFrame)
                end
            end
        end)
    end)

    Notify("Toy", currentTarget.Name .. " にToyを固定しました", 3)
end

local function StopFix()
    if fixConnection then fixConnection:Disconnect() fixConnection = nil end
    if currentToy then
        pcall(function()
            ReplicatedStorage.MenuToys.DestroyToy:FireServer(currentToy)
        end)
        currentToy = nil
    end
    currentTarget = nil
    Notify("Toy", "固定を停止しました", 2)
end

-- ============================================================
-- カメラ視点切り替え（一人称 / 三人称）
-- ============================================================
local function ApplyView(firstPerson)
    viewIsFirstPerson = firstPerson
    if firstPerson then
        LocalPlayer.CameraMode = Enum.CameraMode.LockFirstPerson
        local char = LocalPlayer.Character
        if char then
            local hum = char:FindFirstChildOfClass("Humanoid")
            if hum then hum.CameraOffset = Vector3.new(0, 0.5, 0) end
        end
        Notify("View", "一人称視点", 2)
    else
        LocalPlayer.CameraMode = Enum.CameraMode.Classic
        local char = LocalPlayer.Character
        if char then
            local hum = char:FindFirstChildOfClass("Humanoid")
            if hum then hum.CameraOffset = Vector3.new(0, 0, 0) end
        end
        Notify("View", "三人称視点", 2)
    end
end

-- リスポーン後に視点設定を再適用
LocalPlayer.CharacterAdded:Connect(function()
    task.wait(0.5)
    ApplyView(viewIsFirstPerson)
end)

