-- ============================================================
-- Notify
-- ============================================================
local function Notify(title, text, duration)
    StarterGui:SetCore("SendNotification", {
        Title    = title,
        Text     = text,
        Duration = duration
    })
end

-- ============================================================
-- Noclip
-- ============================================================
local noclipEnabled    = false
local noclipConnection = nil

local function SetNoclip(state)
    noclipEnabled = state
    if noclipConnection then noclipConnection:Disconnect() noclipConnection = nil end

    if state then
        noclipConnection = RunService.Stepped:Connect(function()
            local char = LocalPlayer.Character
            if not char then return end
            for _, part in ipairs(char:GetDescendants()) do
                if part:IsA("BasePart") and part.CanCollide then
                    part.CanCollide = false
                end
            end
        end)
        Notify("Noclip", "有効", 2)
    else
        Notify("Noclip", "無効", 2)
    end
end

-- ============================================================
-- カメラ視点切替（毎フレーム強制適用）
-- ============================================================
local viewIsFirstPerson      = false
local viewEnforceConnection  = nil

local function EnforceView()
    if viewIsFirstPerson then
        if LocalPlayer.CameraMode ~= Enum.CameraMode.LockFirstPerson then
            LocalPlayer.CameraMode = Enum.CameraMode.LockFirstPerson
        end
        if LocalPlayer.CameraMinZoomDistance ~= 0.5 then
            LocalPlayer.CameraMinZoomDistance = 0.5
        end
        if LocalPlayer.CameraMaxZoomDistance ~= 0.5 then
            LocalPlayer.CameraMaxZoomDistance = 0.5
        end
        local char = LocalPlayer.Character
        if char then
            local hum = char:FindFirstChildOfClass("Humanoid")
            if hum and hum.CameraOffset ~= Vector3.new(0, 0.5, 0) then
                hum.CameraOffset = Vector3.new(0, 0.5, 0)
            end
        end
    else
        if LocalPlayer.CameraMode ~= Enum.CameraMode.Classic then
            LocalPlayer.CameraMode = Enum.CameraMode.Classic
        end
        if LocalPlayer.CameraMinZoomDistance ~= 0.5 then
            LocalPlayer.CameraMinZoomDistance = 0.5
        end
        if LocalPlayer.CameraMaxZoomDistance ~= 128 then
            LocalPlayer.CameraMaxZoomDistance = 128
        end
        local char = LocalPlayer.Character
        if char then
            local hum = char:FindFirstChildOfClass("Humanoid")
            if hum and hum.CameraOffset ~= Vector3.new(0, 0, 0) then
                hum.CameraOffset = Vector3.new(0, 0, 0)
            end
        end
    end
end

local function ApplyView(firstPerson)
    viewIsFirstPerson = firstPerson
    EnforceView()

    if viewEnforceConnection then viewEnforceConnection:Disconnect() end
    viewEnforceConnection = RunService.RenderStepped:Connect(EnforceView)

    Notify("View", firstPerson and "一人称視点" or "三人称視点", 2)
end

LocalPlayer.CharacterAdded:Connect(function()
    task.wait(0.5)
    EnforceView()
end)

-- ============================================================
-- Toy 複数人同時固定
-- ============================================================
local activeToys       = {}   -- [Player] = { toy = Instance, conn = RBXScriptConnection }
local multiFixRunning  = false

local function StartLockForPlayer(plr, toy)
    local conn = RunService.Heartbeat:Connect(function()
        if not toy or not toy.Parent then
            if activeToys[plr] then
                if activeToys[plr].conn then activeToys[plr].conn:Disconnect() end
                activeToys[plr] = nil
            end
            return
        end
        local char = plr.Character
        if not char then return end
        local r = char:FindFirstChild("HumanoidRootPart")
        if not r then return end
        pcall(function()
            if toy:IsA("BasePart") then
                toy.CFrame = r.CFrame
            elseif toy:IsA("Model") then
                if not toy.PrimaryPart then
                    for _, p in ipairs(toy:GetDescendants()) do
                        if p:IsA("BasePart") then toy.PrimaryPart = p break end
                    end
                end
                if toy.PrimaryPart then toy:PivotTo(r.CFrame) end
            end
        end)
    end)
    activeToys[plr] = { toy = toy, conn = conn }
end

local function SpawnToyForPlayer(plr)
    if not plr.Character then return end
    local root = plr.Character:FindFirstChild("HumanoidRootPart")
    if not root then return end

    -- 生成前に既存Toyを記録
    local existing = {}
    local folder0 = workspace:FindFirstChild("i1aljSpawnedInToys")
    if folder0 then
        for _, v in ipairs(folder0:GetChildren()) do existing[v] = true end
    end

    pcall(function()
        ReplicatedStorage.MenuToys.SpawnToyRemoteFunction:InvokeServer(table.unpack({
            [1] = "SprayCanWD",
            [2] = root.CFrame,
            [3] = Vector3.new(0, 0, 0),
        }))
    end)

    task.wait(0.15)

    local folder = workspace:FindFirstChild("i1aljSpawnedInToys")
    if not folder then return end

    local newToy
    for _, v in ipairs(folder:GetChildren()) do
        if not existing[v] then
            newToy = v
            break
        end
    end

    if newToy then
        StartLockForPlayer(plr, newToy)
    end
end

local function StartMultiFix()
    if multiFixRunning then return end
    multiFixRunning = true

    task.spawn(function()
        for _, plr in ipairs(Players:GetPlayers()) do
            if plr ~= LocalPlayer and plr.Character then
                SpawnToyForPlayer(plr)
                task.wait(0.2)
            end
        end
        Notify("Toy", "サーバー内全員にToyを固定しました", 3)
        multiFixRunning = false
    end)
end

local function StopMultiFix()
    multiFixRunning = false
    for plr, data in pairs(activeToys) do
        if data.conn then data.conn:Disconnect() end
        if data.toy then
            pcall(function()
                ReplicatedStorage.MenuToys.DestroyToy:FireServer(data.toy)
            end)
        end
    end
    activeToys = {}
    Notify("Toy", "固定を停止しました", 2)
end

-- ============================================================
-- UI 設定（Orion の ScreenGui に UIScale を適用）
-- ============================================================
local function GetOrionScreenGui()
    local parents = {}
    if gethui then pcall(function() table.insert(parents, gethui()) end) end
    pcall(function() table.insert(parents, game:GetService("CoreGui")) end)
    pcall(function() table.insert(parents, LocalPlayer:FindFirstChild("PlayerGui")) end)

    for _, p in ipairs(parents) do
        if p then
            for _, v in ipairs(p:GetChildren()) do
                if v:IsA("ScreenGui") and v.Name == "Orion" then
                    return v
                end
            end
        end
    end
    return nil
end

local uiScaleValue = 1

local function ApplyUIScale(value)
    uiScaleValue = value
    local gui = GetOrionScreenGui()
    if not gui then return end
    local scale = gui:FindFirstChild("__UIScale")
    if not scale then
        scale = Instance.new("UIScale")
        scale.Name = "__UIScale"
        scale.Parent = gui
    end
    scale.Scale = value
end

