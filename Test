--// ============================================
--// Toy Attacher (OrionLib / タッチドラッグ対応・追従方式)
--// ============================================

--// 設定
local ToyName = "SprayCanWD" -- 固定するトイ名

--// Services
local Players = game:GetService("Players")
local ReplicatedStorage = game:GetService("ReplicatedStorage")
local StarterGui = game:GetService("StarterGui")
local RunService = game:GetService("RunService")
local UserInputService = game:GetService("UserInputService")
local LocalPlayer = Players.LocalPlayer

--// Notify（printは使用しない）
local function Notify(title, text, duration)
    pcall(function()
        StarterGui:SetCore("SendNotification", {
            Title = tostring(title),
            Text = tostring(text),
            Duration = duration or 3
        })
    end)
end

--// ゲームの読み込み完了を待つ
if not game:IsLoaded() then
    game.Loaded:Wait()
end

--// ============================================
--// OrionLib取得（新リポジトリ jensonhirst を優先）
--// ============================================

local function FetchSource(url)
    local ok, res = pcall(function()
        return game:HttpGet(url)
    end)
    if ok and type(res) == "string" and #res > 100 then
        return res
    end
    local req = request or http_request or (http and http.request)
    if req then
        local ok2, r = pcall(function()
            return req({ Url = url, Method = "GET" })
        end)
        if ok2 and r and type(r.Body) == "string" and #r.Body > 100 then
            return r.Body
        end
    end
    return nil
end

local OrionSources = {
    "https://raw.githubusercontent.com/jensonhirst/Orion/main/source",
    "https://github.com/jensonhirst/Orion/raw/main/source",
    "https://cdn.jsdelivr.net/gh/jensonhirst/Orion@main/source",
    "https://raw.githubusercontent.com/shlexware/Orion/main/source"
}

local OrionLib = nil
local lastError = "不明"
for _, url in ipairs(OrionSources) do
    local src = FetchSource(url)
    if src then
        local ok, lib = pcall(loadstring(src))
        if ok and lib then
            OrionLib = lib
            break
        else
            lastError = tostring(lib)
        end
    else
        lastError = "取得失敗: " .. url
    end
end

if not OrionLib then
    Notify("エラー", "OrionLib取得失敗: " .. lastError, 6)
    return
end

--// ============================================
--// 本体処理
--// ============================================

local AttachedToy = nil
local FollowConnection = nil
local TargetName = ""

local function StopFollowing()
    if FollowConnection then
        FollowConnection:Disconnect()
        FollowConnection = nil
    end
end

local function GetPlayerNames()
    local list = {}
    for _, plr in ipairs(Players:GetPlayers()) do
        if plr ~= LocalPlayer then
            table.insert(list, plr.Name)
        end
    end
    return list
end

local function AttachToyTo(targetName)
    Notify("処理中", "召喚リクエストを送信中...", 2)

    local target = Players:FindFirstChild(targetName)
    if not target then
        Notify("エラー", "プレイヤーが見つかりません: " .. tostring(targetName), 3)
        return
    end

    local char = target.Character
    local hrp = char and char:FindFirstChild("HumanoidRootPart")
    if not hrp then
        Notify("エラー", targetName .. " のHumanoidRootPartが見つかりません", 3)
        return
    end

    -- 既に固定中のトイを削除
    StopFollowing()
    if AttachedToy and AttachedToy.Parent then
        pcall(function()
            ReplicatedStorage.MenuToys.DestroyToy:FireServer(AttachedToy)
        end)
        task.wait(0.3)
    end

    local toyFolder = workspace:FindFirstChild("i1aljSpawnedInToys")
    if not toyFolder then
        Notify("エラー", "i1aljSpawnedInToysが見つかりません", 3)
        return
    end

    local spawnedToy = nil
    local conn
    conn = toyFolder.ChildAdded:Connect(function(child)
        spawnedToy = child
        conn:Disconnect()
    end)

    local spawnCF = hrp.CFrame
    local ok, err = pcall(function()
        ReplicatedStorage.MenuToys.SpawnToyRemoteFunction:InvokeServer(
            ToyName,
            spawnCF,
            Vector3.new(0, -65.08200073242188, 0)
        )
    end)

    if not ok then
        conn:Disconnect()
        Notify("エラー", "召喚失敗: " .. tostring(err), 4)
        return
    end

    Notify("処理中", "トイの出現を待機中...", 2)

    local toy = nil
    for _ = 1, 24 do
        if spawnedToy and spawnedToy.Parent then
            toy = spawnedToy
            break
        end
        task.wait(0.25)
    end
    conn:Disconnect()

    if not toy then
        toy = toyFolder:FindFirstChild(ToyName)
    end
    if not toy then
        Notify("エラー", "トイのスポーンを検出できませんでした", 3)
        return
    end

    Notify("検出", "トイ検出: " .. toy.Name, 2)

    -- ベースパーツ取得
    local basePart
    if toy:IsA("BasePart") then
        basePart = toy
    elseif toy:IsA("Model") then
        basePart = toy.PrimaryPart or toy:FindFirstChildWhichIsA("BasePart")
    end
    if not basePart then
        Notify("エラー", "トイのパーツが見つかりません", 3)
        return
    end

    -- ローカルでアンカー（物理との競合を防ぐ）
    pcall(function() basePart.Anchored = true end)

    -- 毎フレーム体中心に追従
    FollowConnection = RunService.Heartbeat:Connect(function()
        local c = target.Character
        local root = c and c:FindFirstChild("HumanoidRootPart")
        if root and toy.Parent then
            pcall(function()
                basePart.CFrame = root.CFrame
            end)
        end
    end)

    AttachedToy = toy
    Notify("成功", targetName .. " の体に " .. ToyName .. " を固定しました", 3)
end

local function DestroyAttachedToy()
    StopFollowing()
    if AttachedToy and AttachedToy.Parent then
        local ok, err = pcall(function()
            ReplicatedStorage.MenuToys.DestroyToy:FireServer(AttachedToy)
        end)
        if ok then
            AttachedToy = nil
            Notify("削除", "トイを削除しました", 3)
        else
            Notify("エラー", tostring(err), 3)
        end
    else
        AttachedToy = nil
        Notify("情報", "固定中のトイがありません", 3)
    end
end

local function ToggleView(state)
    if state then
        LocalPlayer.CameraMode = Enum.CameraMode.LockFirstPerson
        Notify("視点", "一人称に切り替えました", 2)
    else
        LocalPlayer.CameraMode = Enum.CameraMode.Classic
        Notify("視点", "三人称に切り替えました", 2)
    end
end

--// ターゲットのキャラがリスポーンしても追従し続ける
Players.PlayerRemoving:Connect(function(plr)
    if AttachedToy and AttachedToy.Parent then
        pcall(function()
            ReplicatedStorage.MenuToys.DestroyToy:FireServer(AttachedToy)
        end)
        AttachedToy = nil
    end
    StopFollowing()
end)

